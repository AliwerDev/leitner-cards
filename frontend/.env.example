# ── Server-only ──────────────────────────────────────────────────────────
# Never prefixed NEXT_PUBLIC_: with the proxy architecture the browser must
# not learn the API address, and a NEXT_PUBLIC_ var is inlined into the
# client bundle.
#
# Inside docker compose:  http://nginx/api/v1
# On the host machine:    http://localhost:8080/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# Request timeout for calls to the PHP API, in milliseconds.
API_TIMEOUT_MS=10000

# Refresh the access token this many seconds before it expires.
TOKEN_REFRESH_SKEW_SECONDS=120

# ── Public ───────────────────────────────────────────────────────────────
# The public origin of this app. Used for absolute redirect URLs only.
NEXT_PUBLIC_APP_URL=http://localhost:3000
