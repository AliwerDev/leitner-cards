# Optional. Overrides the automatic base URL detection in lib/api/config.ts.
#
# Leave this unset for the normal cases: an Android emulator resolves 10.0.2.2,
# an iOS simulator resolves localhost, and a physical device on the same Wi-Fi
# picks up the LAN address Metro is already serving from.
#
# Set it when the API does not run on port 8080 of the Metro host, for example a
# staging server or a tunnelled backend.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8080/api/v1
#
# A release build must have this value, because there is no Metro host to detect
# and the fallback address 10.0.2.2 reaches an emulator only. Do not put the
# value here for a build: eas.json sets it per profile, and this directory
# ignores only `.env*.local`, so a plain `.env` goes into git.
