{
  "info": {
    "name": "Leitner API",
    "description": "Leitner flashcards tizimi uchun REST API.\n\nISHLATISH:\n1. Avval Auth > Register (yoki Login) ni yuboring - tokenlar avtomatik saqlanadi\n2. Qolgan so'rovlar tokenni o'zi ishlatadi, qo'lda nusxalash shart emas\n\nbase_url o'zgaruvchisi: http://localhost:8080/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "deck_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "username",
      "value": "ali",
      "type": "string"
    },
    {
      "key": "email",
      "value": "ali@test.uz",
      "type": "string"
    },
    {
      "key": "password",
      "value": "secret123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Servis va DB holatini tekshiradi. Token kerak emas."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('DB ishlayapti', function () {",
              "    pm.expect(pm.response.json().data.db).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Yangi foydalanuvchi yaratadi va darhol token juftligini qaytaradi.\n\n201 = yaratildi\n422 = email yoki username band"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.access_token) {",
                  "        pm.collectionVariables.set('access_token', body.data.access_token);",
                  "        pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "        console.log('Tokenlar saqlandi');",
                  "    }",
                  "    pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "} else if (pm.response.code === 422) {",
                  "    console.log('Bu foydalanuvchi allaqachon bor - Login ni ishlating');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"login\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "login maydoniga username YOKI email yozsa bo'ladi.\n\nTokenlar avtomatik saqlanadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.access_token) {",
                  "        pm.collectionVariables.set('access_token', body.data.access_token);",
                  "        pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "        console.log('Tokenlar saqlandi');",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Joriy foydalanuvchi ma'lumotlari. Bearer token talab qiladi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "DIQQAT: refresh token bir martalik.\nHar chaqirilganda eskisi bekor bo'lib yangisi beriladi.\nBir xil token bilan ikkinchi marta chaqirsangiz 401 - bu to'g'ri."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    if (body.data && body.data.access_token) {",
                  "        pm.collectionVariables.set('access_token', body.data.access_token);",
                  "        pm.collectionVariables.set('refresh_token', body.data.refresh_token);",
                  "        console.log('Tokenlar saqlandi');",
                  "    }",
                  "    pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Refresh tokenni bekor qiladi.\nBody bo'sh bo'lsa - foydalanuvchining HAMMA tokenlari bekor qilinadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('refresh_token', '');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Decks",
      "item": [
        {
          "name": "List decks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/decks?page=1&per-page=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "decks"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per-page",
                  "value": "20"
                }
              ]
            },
            "description": "Faqat joriy foydalanuvchining decklari.\nSahifalash ma'lumoti X-Pagination-* header'larida."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create deck",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Ingliz tili\",\n    \"description\": \"Kundalik sozlar\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/decks",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "decks"
              ]
            },
            "description": "Yangi deck yaratadi.\nYaratilgan ID avtomatik deck_id o'zgaruvchisiga tushadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('deck_id', body.data.deck.id);",
                  "    console.log('deck_id saqlandi: ' + body.data.deck.id);",
                  "    pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "View deck",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/decks/{{deck_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "decks",
                "{{deck_id}}"
              ]
            },
            "description": "Bitta deck.\nBoshqa foydalanuvchining decki bo'lsa 404 qaytadi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update deck",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Ingliz tili - B2\",\n    \"description\": \"Yangilangan tavsif\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/decks/{{deck_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "decks",
                "{{deck_id}}"
              ]
            },
            "description": "PUT yoki PATCH ishlaydi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete deck",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/decks/{{deck_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "decks",
                "{{deck_id}}"
              ]
            },
            "description": "Deckni butunlay o'chiradi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Xato holatlari",
      "item": [
        {
          "name": "Me - token yo'q (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Himoyalangan endpoint tokensiz - 401 qaytishi kerak."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - takroriy (422)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{username}}\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Allaqachon ro'yxatdan o'tgan foydalanuvchi.\nJavobda error.fields ichida qaysi maydon xato ekani ko'rsatiladi."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "pm.test('fields mavjud', function () {",
                  "    pm.expect(pm.response.json().error).to.have.property('fields');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - noto'g'ri parol (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"login\": \"{{username}}\",\n    \"password\": \"notogriparol\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Deck - mavjud emas (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/decks/999999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "decks",
                "999999"
              ]
            },
            "description": "Mavjud bolmagan deck - 404 JSON qaytadi (HTML emas)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404', () => pm.response.to.have.status(404));"
                ]
              }
